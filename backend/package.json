{
  "name": "blazekonzult-api",
  "version": "1.0.0",
  "description": "BlazeKonzult assessment & lead platform API (Express + MySQL)",
  "main": "app.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.js",
    "start": "node app.js",
    "migrate": "node dist/cli.js migrate",
    "seed": "node dist/cli.js seed",
    "create-owner": "node dist/cli.js create-owner",
    "cron": "node dist/cron.js",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "express": "4.22.3",
    "mysql2": "3.24.6",
    "nodemailer": "6.10.1",
    "pdfkit": "0.15.2",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/express": "4.17.25",
    "@types/node": "20.19.43",
    "@types/nodemailer": "8.0.2",
    "@types/pdfkit": "0.17.7",
    "@types/qrcode": "^1.5.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "private": true,
  "engines": {
    "node": ">=18.17"
  }
}
