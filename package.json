{
  "name": "blazekonzult",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run build && NODE_ENV=production node server.js",
    "build": "NODE_ENV=production next build --webpack && npm run build:api",
    "build:web": "next build --webpack",
    "start": "node server.js",
    "lint": "eslint",
    "migrate": "node backend/dist/cli.js migrate",
    "seed": "node backend/dist/cli.js seed",
    "create-owner": "node backend/dist/cli.js create-owner",
    "cron": "node backend/dist/cron.js",
    "setup": "node backend/dist/cli.js setup",
    "reset-2fa": "node backend/dist/cli.js reset-2fa",
    "build:api": "npm --prefix backend install --include=dev --no-audit --no-fund && npm --prefix backend run build",
    "dev:local": "node server.js --dev"
  },
  "dependencies": {
    "express": "4.22.3",
    "lucide-react": "^1.28.0",
    "mysql2": "3.24.6",
    "next": "16.3.0",
    "nodemailer": "6.10.1",
    "pdfkit": "0.15.2",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9"
  }
}
